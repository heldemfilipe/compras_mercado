# ==========================================================
# Copie este arquivo para .env.local e preencha os valores.
# Você encontra tudo em: Supabase > Project Settings > API
# ==========================================================

# URL do projeto Supabase (ex.: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "anon" / "publishable"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" — SECRETA, NUNCA vai para o navegador.
# Usada apenas pelo script scripts/create-user.mjs para criar usuários.
SUPABASE_SERVICE_ROLE_KEY=
